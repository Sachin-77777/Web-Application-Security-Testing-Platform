# ---------------------------------------------------------------------------
# Web Application Security Testing Platform - example environment file
#
# Copy this file to ".env" and replace the values. Never commit the real .env
# (it is already listed in .gitignore).
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
# ---------------------------------------------------------------------------

# Flask environment: development | production | testing
FLASK_ENV=development

# Signs the session cookie and the CSRF token. Use a long random string.
# Must be at least 32 characters. Production refuses to start with the default.
# PowerShell:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Security hardening
# ---------------------------------------------------------------------------
# Send the session / remember-me cookies only over HTTPS. Leave "false" for
# local http://127.0.0.1 demos; set "true" (the production default) when HTTPS.
SESSION_COOKIE_SECURE=false

# Add the defense-in-depth response headers (CSP, X-Frame-Options, ...).
SECURITY_HEADERS_ENABLED=true

# Login brute-force protection, shared by the HTML form and the JSON API.
# After N failed attempts for one IP+username the key is locked for the
# lockout period. Failed attempts older than the window are forgotten.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=300

# ---------------------------------------------------------------------------
# MySQL connection (used when DATABASE_URL is left empty)
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=wastp

# Optional: full connection string. When set it OVERRIDES the MYSQL_* values.
# MySQL example:   mysql+pymysql://root:password@localhost:3306/wastp
# SQLite example:  sqlite:///wastp.db   (relative to instance/, created on start)
# DATABASE_URL=

# ---------------------------------------------------------------------------
# JSON API (/api) - JWT bearer tokens
# ---------------------------------------------------------------------------
# Leave empty to fall back to SECRET_KEY. Set a separate value in production.
JWT_SECRET_KEY=
# Access token lifetime in minutes and refresh token lifetime in days.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Folder for generated report documents. Defaults to <project>/instance/reports
# REPORTS_FOLDER=

# Database used by the test suite (only for FLASK_ENV=testing)
# TEST_DATABASE_URI=sqlite:///:memory:

# ---------------------------------------------------------------------------
# Demo seed (seed.py) - optional overrides
# ---------------------------------------------------------------------------
# One account per role is created. These passwords are for local demos only.
# SEED_ADMIN_USERNAME=admin1
# SEED_ADMIN_EMAIL=admin1@example.com
# SEED_ADMIN_PASSWORD=password123
# SEED_USER_USERNAME=owner1
# SEED_USER_EMAIL=owner1@example.com
# SEED_USER_PASSWORD=password123
# SEED_CLIENT_USERNAME=client1
# SEED_CLIENT_EMAIL=client1@example.com
# SEED_CLIENT_PASSWORD=password123
# Set to 0 to seed only the accounts, without the example casework.
# SEED_DEMO_DATA=1
