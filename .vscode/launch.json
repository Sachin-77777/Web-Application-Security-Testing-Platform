{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run WASTP (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\app.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}\\.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Pytest (whole suite)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}